{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "triptrace-ai-next",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "triptrace-ai-next"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triptrace",
      "database_id": "af462150-c240-4e1b-9552-a9245d501155"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "triptrace-media"
    }
  ],
  "vars": {
    "APP_NAME": "TripTrace.ai"
  }
}
