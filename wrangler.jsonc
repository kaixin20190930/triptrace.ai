{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "triptrace-ai-next",
	"compatibility_date": "2026-05-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "triptrace-ai-next"
		}
	],
	// Declaring any route makes Wrangler disable workers.dev unless it is asked for explicitly,
	// which takes the deployment offline as a side effect. Keep this true so the fallback URL
	// survives regardless of what happens to the apex.
	"workers_dev": true,
	// A route rather than a custom domain, because the apex still carries the DNS record that
	// the retired Pages project left behind, and a custom domain refuses to claim a hostname
	// that already has externally managed records. The route intercepts at the edge before any
	// origin fetch, so it serves correctly regardless. Declared here so that a deploy cannot
	// silently drop it and take the apex offline.
	"routes": [
		{
			"pattern": "triptrace.ai/*",
			"zone_name": "triptrace.ai"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "triptrace-atlas",
			"database_id": "0d56a659-0aa9-4eb2-adca-8a150c212ee0"
		}
	],
	// The application resolves storage by binding name, so `MEDIA` must be the new bucket.
	// A second binding pointing at the new bucket would be ignored by every code path.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "triptrace-atlas-media"
		}
	],
	"vars": {
		"APP_NAME": "TripTrace.ai"
	}
}