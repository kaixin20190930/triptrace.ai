{
  "name": "triptrace-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "test:api": "node scripts/api-entitlement-tests.mjs",
    "test:map": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/atlas-projection-tests.mts",
    "test:stripe": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/stripe-unit-tests.mts",
    "test:cleanup": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/media-cleanup-unit-tests.mts",
    "test:clustering": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/photo-clustering-tests.mts",
    "test:zip": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/zip-unit-tests.mts",
    "test:share": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/share-links-unit-tests.mts",
    "test:resurfacing": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/resurfacing-unit-tests.mts",
    "test:filters": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-runner.mjs scripts/trace-filters-unit-tests.mts",
    "test:unit": "npm run test:map && npm run test:stripe && npm run test:cleanup && npm run test:clustering && npm run test:zip && npm run test:share && npm run test:resurfacing && npm run test:filters",
    "test:billing": "node scripts/api-billing-tests.mjs",
    "test:account": "node scripts/api-account-data-tests.mjs",
    "test:sharing": "node scripts/api-sharing-tests.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:smoke": "node scripts/deployment-smoke-tests.mjs",
    "test:all": "npm run lint && tsc --noEmit && npm run test:unit && npm run test:e2e",
    "build:world-land": "node scripts/build-world-land.mjs",
    "qa:cleanup": "wrangler d1 execute DB --local --file=scripts/qa-cleanup.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.100.0"
  }
}
